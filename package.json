{
  "name": "petro-sprawl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build -c vite.notfound.config.ts && vite build -c vite.functions.config.ts && tsx jobs/build-share-index.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:refineries-us": "python3 -I jobs/import-refineries-us.py && tsx jobs/import-refineries-us.ts",
    "import:refineries-eu": "python3 -I jobs/import-refineries-eu.py && tsx jobs/import-refineries-eu.ts",
    "import:basins": "tsx jobs/import-basins.ts",
    "import:shale-plays": "tsx jobs/import-shale-plays.ts",
    "import:fields": "python3 -I jobs/import-fields.py && tsx jobs/import-fields.ts",
    "import:countries": "tsx jobs/import-countries.ts",
    "import:us-lookup": "tsx jobs/import-us-lookup.ts",
    "import:us-regions": "tsx jobs/import-us-regions.ts",
    "import:lng": "tsx jobs/import-lng.ts",
    "import:chokepoints": "tsx jobs/import-chokepoints.ts",
    "import:gem-companies": "python3 -I jobs/import-gem-companies.py",
    "import:gem": "tsx jobs/import-gem.ts",
    "fetch:portwatch": "tsx jobs/fetch-portwatch.ts",
    "fetch:entsog": "tsx jobs/fetch-entsog.ts",
    "fetch:agsi": "tsx --env-file-if-exists=.env jobs/fetch-agsi.ts",
    "fetch:alsi": "tsx --env-file-if-exists=.env jobs/fetch-alsi.ts",
    "fetch:eia": "tsx --env-file-if-exists=.env jobs/fetch-eia.ts",
    "fetch:shale": "tsx --env-file-if-exists=.env jobs/fetch-shale.ts",
    "fetch:storage": "tsx --env-file-if-exists=.env jobs/fetch-storage.ts",
    "fetch:crude-imports": "tsx --env-file-if-exists=.env jobs/fetch-crude-imports.ts",
    "fetch:all": "npm run fetch:portwatch && npm run fetch:entsog && npm run fetch:agsi && npm run fetch:alsi && npm run fetch:eia && npm run fetch:shale && npm run fetch:storage && npm run fetch:crude-imports",
    "build:curated": "tsx jobs/build-curated.ts",
    "refresh:claims": "tsx --env-file-if-exists=.env jobs/refresh-claims.ts",
    "apply:claim-drafts": "tsx jobs/apply-claim-drafts.ts",
    "check:eia-refineries": "tsx jobs/check-eia-refineries.ts",
    "scan:news": "tsx --env-file-if-exists=.env jobs/scan-news.ts",
    "apply:disruption-drafts": "tsx jobs/apply-disruption-drafts.ts",
    "merge:review-drafts": "tsx jobs/merge-review-drafts.ts",
    "import:globe": "tsx jobs/import-globe.ts",
    "render:og": "tsx jobs/render-og.ts",
    "build:share": "tsx jobs/build-share-index.ts",
    "record:demo": "tsx jobs/record-demo.ts",
    "video": "npm --prefix video run dev",
    "video:render": "cd video && npx remotion render Wide ../demo/petro-sprawl-wide.mp4 --crf=16 && npx remotion render Square ../demo/petro-sprawl-square.mp4 --crf=16 && npx remotion render UiOnly ../demo/petro-sprawl-ui.mp4 --crf=16"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.5",
    "@vercel/og": "^0.11.1",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "mapshaper": "^0.7.100",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
