# Only the fetch jobs need these; the app runs on the committed data without them.
EIA_API_KEY=          # https://www.eia.gov/opendata/ (fetch:eia, fetch:storage, fetch:shale)
AGSI_API_KEY=         # https://agsi.gie.eu/ account (fetch:agsi, fetch:alsi)
COMTRADE_API_KEY=     # optional, https://comtradedeveloper.un.org/ (fetch:crude-imports uses the public preview without it)
ANTHROPIC_API_KEY=    # scan:news, refresh:claims
